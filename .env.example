# This is an example env file for the project
# real values should be tested locally in a new ".env.local" file and not committed to the repo
# and when applying to production, the values should be set in Vercel's environment variables settings

# The URL of your Supabase project
NEXT_PUBLIC_SUPABASE_URL=XXXX

# The public API key for your Supabase project
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=XXXX

# Clerk publishable key (safe for client-side use)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=XXXX

# Clerk secret key (server-side only, never expose to the client)
CLERK_SECRET_KEY=XXXX

# Resend API key, used to send applicant confirmation, status-change, and
# staff-alert emails
RESEND_API_KEY=XXXX

# The "From" address emails are sent from, must be on a domain verified in Resend
RESEND_FROM_ADDRESS=XXXX

# Where the new-application staff alert email is sent, unless overridden
# from Admin > Settings (that override takes precedence when set).
STAFF_ALERT_EMAIL=XXXX
